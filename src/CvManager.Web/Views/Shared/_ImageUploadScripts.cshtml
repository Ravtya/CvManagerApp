@using System.Text.Json
@using CvManager.Web.Options
@using Microsoft.Extensions.Options
@inject IOptions<BytescaleOptions> Bytescale
@{
    var apiKey = Bytescale.Value.ApiKey;
}
<script>
    window.ImageUploadConfig = {
        apiKey: @Html.Raw(JsonSerializer.Serialize(apiKey))
    };
</script>
<script src="https://js.bytescale.com/upload-widget/v4"></script>
<script src="~/js/image-upload.js" asp-append-version="true"></script>
<script>window.ImageUpload?.init();</script>