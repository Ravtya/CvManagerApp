@model HomePageDto
@{
    ViewData["Title"] = L["Home_Index_WelcomeTitle"];
    var maxTagCount = Model.TagCloud.Count == 0 ? 1 : Model.TagCloud.Max(t => t.Count);
}

<h1 class="h4 mb-3">@L["Home_Index_WelcomeTitle"]</h1>

<div class="row g-3 mb-4 small">
    <div class="col-6 col-md"><strong>@Model.TotalPositions</strong> <span class="text-muted">@L["Home_Index_Stat_Positions"]</span></div>
    <div class="col-6 col-md"><strong>@Model.TotalCandidates</strong> <span class="text-muted">@L["Home_Index_Stat_Candidates"]</span></div>
    <div class="col-6 col-md"><strong>@Model.TotalRecruiters</strong> <span class="text-muted">@L["Home_Index_Stat_Recruiters"]</span></div>
    <div class="col-6 col-md"><strong>@Model.TotalCvs</strong> <span class="text-muted">@L["Shared_CVs"]</span></div>
    <div class="col-6 col-md"><strong>@Model.CvsPublishedLast24Hours</strong> <span class="text-muted">@L["Home_Index_Stat_Cvs24h"]</span></div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <h2 class="h6 mb-2">@L["Home_Index_LatestPositions"]</h2>
        <div class="mb-2">
            <partial name="_HomePositionTable" model="@(new HomePositionTableModel
            {
                Items = Model.LatestPositions,
                TitleHeader = L["Shared_Title"],
                SecondaryHeader = L["Shared_Access"],
                Secondary = HomePositionSecondaryColumn.Access,
                EmptyText = L["Home_Index_NoPositions"],
                ShowDescription = true
            })"/>
        </div>
    </div>

    <div class="col-lg-5">
        <h2 class="h6 mb-2">@L["Home_Index_PopularPositions"]</h2>
        <div class="mb-4">
            <partial name="_HomePositionTable" model="@(new HomePositionTableModel
            {
                Items = Model.PopularPositions,
                TitleHeader = L["Shared_Title"],
                SecondaryHeader = L["Shared_CVs"],
                Secondary = HomePositionSecondaryColumn.CvCount,
                EmptyText = L["Home_Index_NoPositions"]
            })"/>
        </div>

        <h2 class="h6 mb-2">@L["Home_Index_TagCloud"]</h2>
        @if (Model.TagCloud.Count == 0)
        {
            <p class="text-muted small mb-0">@L["Home_Index_NoTags"]</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2 align-items-baseline mb-0">
                @foreach (var tag in Model.TagCloud)
                {
                    var ratio = tag.Count / (double)maxTagCount;
                    var sizeClass = ratio >= 0.66 ? "fs-4" : ratio >= 0.33 ? "fs-5" : "fs-6";
                    <a asp-controller="Search"
                       asp-action="Index"
                       asp-route-query="@tag.Name"
                       class="text-decoration-none @sizeClass"
                       title="@tag.Count">@tag.Name</a>
                }
            </div>
        }
    </div>
</div>
