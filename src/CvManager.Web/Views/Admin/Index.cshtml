@model PagedResult<UserListItemDto>
@{
    ViewData["Title"] = L["Shared_Users"];
    var search = ViewBag.Search as string;
    ViewData["PagerRoute"] = new Dictionary<string, string?> { ["search"] = search };
}

<h1 class="h4 mb-3 text-center">@L["Shared_Users"]</h1>

<partial name="_ListSearch" model="search"/>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3 d-flex justify-content-between gap-2">
        <div class="d-flex gap-2">
            <select class="form-select w-auto" name="role">
                @foreach (var role in RoleNames.All)
                {
                    <option value="@role">@role</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary" formaction="@Url.Action("ChangeRoles")" name="assign"
                    value="true">@L["Admin_Index_AssignRole"]</button>
            <button type="submit" class="btn btn-outline-secondary" formaction="@Url.Action("ChangeRoles")" name="assign"
                    value="false">@L["Admin_Index_RemoveRole"]</button>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-outline-secondary" formaction="@Url.Action("SetBlockState")" name="block"
                    value="true"><i class="bi bi-lock"></i></button>
            <button type="submit" class="btn btn-outline-secondary" formaction="@Url.Action("SetBlockState")" name="block"
                    value="false"><i class="bi bi-unlock"></i></button>
            <button type="submit" class="btn btn-outline-secondary"
                    formaction="@Url.Action("DeleteUsers")"><i class="bi bi-trash"></i></button>
        </div>
    </div>

    <table class="table table-bordered">
        <thead>
        <tr>
            <th class="text-center">
                <input type="checkbox" class="form-check-input" data-select-all=".row-select"/>
            </th>
            <th>@L["Shared_Email"]</th>
            <th>@L["Admin_Index_Col_Roles"]</th>
            <th>@L["Admin_Index_Col_Status"]</th>
            <th>@L["Admin_Index_Col_EmailConfirm"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Items)
        {
            <tr>
                <td class="text-center">
                    <input type="checkbox" class="form-check-input row-select" name="userIds" value="@user.Id"/>
                </td>
                <td>
                    <a asp-controller="Profile" asp-action="Index" asp-route-userId="@user.Id">@user.Email</a>
                </td>
                <td>@string.Join(", ", user.Roles)</td>
                <td>@(user.IsLockedOut ? L["Admin_Index_Status_Blocked"] : L["Admin_Index_Status_Active"])</td>
                <td>@(user.IsEmailConfirmed ? L["Admin_Index_Status_Confirmed"] : L["Admin_Index_Status_Unconfirmed"])</td>
            </tr>
        }
        </tbody>
    </table>
</form>

<partial name="_Pager" model="@(new PagerModel { Page = Model.Page, TotalCount = Model.TotalCount })"/>
